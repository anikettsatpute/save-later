rules_version = '2';

// Save Later — per-user private library.
// Every document lives under users/{uid}/... and only that uid can read/write.
// AI provider keys (Gemini / OpenRouter / Azure) are NEVER stored here —
// they stay in secure storage / SharedPreferences on each device.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
